{
  "name": "@fms/api-schemas",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "EMPTY_OUT_DIR=true vite build",
    "watch": "vite build --watch",
    "type:check": "tsc --noEmit",
    "lint:check": "biome check",
    "lint:format": "biome check --write"
  },
  "dependencies": {
    "@fms/common-utils": "workspace:^",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@fms/biome-config": "workspace:^",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "exports": {
    "./requests/*": {
      "require": {
        "types": "./dist/requests/*/index.d.ts",
        "default": "./dist/requests/*/index.cjs"
      },
      "import": {
        "types": "./dist/requests/*/index.d.ts",
        "default": "./dist/requests/*/index.mjs"
      }
    },
    "./responses/*": {
      "require": {
        "types": "./dist/responses/*/index.d.ts",
        "default": "./dist/responses/*/index.cjs"
      },
      "import": {
        "types": "./dist/responses/*/index.d.ts",
        "default": "./dist/responses/*/index.mjs"
      }
    }
  }
}
