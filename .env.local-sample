# 로컬 개발용 환경변수 예시. 복사해서 .env.local 로 저장해 사용합니다.
DB_HOST=127.0.0.1
DB_PORT=15432
DB_USER=fms
DB_PASSWORD=fms-local-password
DB_NAME=fms

INITIAL_ADMIN_ID=admin
INITIAL_ADMIN_PASSWORD=admin1234!
INITIAL_ADMIN_NICKNAME=최초 관리자

API_PORT=4000
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# admin-web · user-web 이 서버에서 api 를 호출하며 원래 요청 IP 를 X-Forwarded-For 로 넘긴다. 그 프록시를 신뢰할 대상
API_TRUST_PROXY=loopback
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=1024
# 공개 링크 비밀번호 인증 유지 시간(초). 비우면 600
SHARE_LINK_UNLOCK_EXPIRES_IN_SECONDS=600

# admin-web · user-web (서버 쪽에서 api 를 호출할 주소)
API_INTERNAL_URL=http://127.0.0.1:4000
# admin-web · user-web 앞단에 있는 신뢰할 수 있는 프록시 수 (직접 노출이면 0)
WEB_TRUSTED_PROXY_HOPS=0
WEB_SECURE_COOKIE=false
# 공개 링크 다운로드 실패 문구를 담아 두는 쿠키의 수명(초). 비우면 10
SHARE_LINK_DOWNLOAD_ERROR_COOKIE_MAX_AGE_SECONDS=10
USER_WEB_ORIGIN=http://localhost:3001
