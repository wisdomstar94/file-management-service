# 로컬 개발용 환경변수 예시. 복사해서 .env.local 로 저장해 사용합니다.
DB_HOST=127.0.0.1
DB_PORT=15432
DB_USER=fms
DB_PASSWORD=fms-local-password
DB_NAME=fms

INITIAL_ADMIN_ID=admin
INITIAL_ADMIN_PASSWORD=admin1234!
INITIAL_ADMIN_NICKNAME=최초 관리자

API_PORT=4000
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=1024
# 공개 링크 비밀번호 인증 유지 시간(초). 비우면 600
SHARE_LINK_UNLOCK_EXPIRES_IN_SECONDS=600

# web 서버가 api 를 호출하며 원래 요청 IP 를 X-Forwarded-For 로 넘긴다. 그 프록시를 신뢰할 대상
# 도커 밖에서 띄울 때만 쓰인다. 도커에서는 compose 가 web 컨테이너 IP 로 고정한다.
API_TRUST_PROXY=loopback

# 브라우저에서 api 를 직접 호출하는 web 의 origin 을 반드시 포함한다.
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# web 서버가 api 를 호출할 주소. 같은 망의 내부 주소든 공인 IP · 도메인이든 web 서버에서 닿기만 하면 된다.
API_INTERNAL_URL=http://127.0.0.1:4000
# 브라우저가 api 를 직접 호출할 주소. 사용자 브라우저에서 닿아야 한다.
# web 서버와 브라우저가 같은 주소로 api 에 닿는 환경(공인 도메인 등)이면 API_INTERNAL_URL 과 같은 값을 넣으면 된다.
API_PUBLIC_URL=http://localhost:4000

# web 앞단에 있는 신뢰할 수 있는 프록시 수 (직접 노출이면 0)
WEB_TRUSTED_PROXY_HOPS=0
WEB_SECURE_COOKIE=false

# 공개 링크 다운로드 실패 문구를 담아 두는 쿠키의 수명(초). 비우면 10
SHARE_LINK_DOWNLOAD_ERROR_COOKIE_MAX_AGE_SECONDS=10
USER_WEB_ORIGIN=http://localhost:3001
