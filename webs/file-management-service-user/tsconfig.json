{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowJs": true,
    "esModuleInterop": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules", "e2e", "playwright.config.ts"],
  "references": [
    {
      "path": "../../libs/common-shared/api-schemas"
    },
    {
      "path": "../../libs/common-shared/consts"
    },
    {
      "path": "../../libs/common-shared/error-provider"
    },
    {
      "path": "../../libs/common-shared/types"
    },
    {
      "path": "../../libs/web-shared/web-ui"
    },
    {
      "path": "../../libs/web-shared/web-utils"
    }
  ]
}
