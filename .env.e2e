# e2e 전용 격리 환경(dockers/compose.e2e.yml)의 환경변수. scripts/run-e2e.sh 로 실행하면 모든 컨테이너가 이 파일을 읽습니다.

# 실행 환경. local · development · production · e2e 중 하나
APP_ENV=e2e

DB_HOST=postgres
DB_PORT=5432
DB_USER=fms
DB_PASSWORD=fms-e2e-password
DB_NAME=fms

INITIAL_ADMIN_ID=admin
INITIAL_ADMIN_PASSWORD=admin1234!
INITIAL_ADMIN_NICKNAME=최초 관리자

API_PORT=4000
JWT_SECRET=e2e-jwt-secret-e2e-jwt-secret-e2e-jwt-secret

STORAGE_DIR=/data/storage
MAX_UPLOAD_SIZE_MB=1024
# 공개 링크 비밀번호 인증 유지 시간(초). 비우면 600
SHARE_LINK_UNLOCK_EXPIRES_IN_SECONDS=600

# web 서버가 api 를 호출하며 원래 요청 IP 를 X-Forwarded-For 로 넘긴다. 그 요청을 보내는 쪽(web 서버 · 프록시)의 주소나 대역을 적는다.
# dockers/compose.yml 로 띄우면 compose 가 web 컨테이너 IP 로 고정하므로 이 값은 쓰이지 않는다.
API_TRUST_PROXY=172.31.250.0/24

# 브라우저에서 api 를 직접 호출하는 web 의 origin 을 반드시 포함한다.
API_CORS_ORIGINS=http://admin.fms.test:3000,http://user.fms.test:3001
# api 가 심는 쿠키(관리자 토큰 · 공개 링크 잠금 해제)를 https 로만 보낼지. 운영(https)에서는 true
API_SECURE_COOKIE=false

# api 와 web 서버가 관리자 토큰 쿠키를 함께 쓸 상위 도메인 (예 .example.com). api · web 양쪽에 같은 값을 넣는다.
# 비우면 호스트 한정이다. 쿠키는 포트를 구분하지 않아 localhost 처럼 같은 호스트에 포트만 다르게 띄우면 비워도 된다.
# api 와 web 은 같은 사이트(같은 상위 도메인)에 있어야 브라우저가 쿠키를 주고받는다.
COOKIE_DOMAIN=fms.test

# web 서버가 api 를 호출할 주소. 같은 망의 내부 주소든 공인 IP · 도메인이든 web 서버에서 닿기만 하면 된다.
API_INTERNAL_URL=http://api:4000
# 브라우저가 api 를 직접 호출할 주소. 사용자 브라우저에서 닿아야 한다.
# web 서버와 브라우저가 같은 주소로 api 에 닿는 환경(공인 도메인 등)이면 API_INTERNAL_URL 과 같은 값을 넣으면 된다.
API_PUBLIC_URL=http://api.fms.test:4000

# web 앞단에 있는 신뢰할 수 있는 프록시 수 (직접 노출이면 0)
WEB_TRUSTED_PROXY_HOPS=0
WEB_SECURE_COOKIE=false

# 공개 링크 화면을 띄우는 web 의 origin. 관리자 화면의 링크 복사와 api 의 다운로드 실패 리다이렉트에 쓴다.
USER_WEB_ORIGIN=http://user.fms.test:3001

# ---- 아래는 e2e 전용 ----

# 테스트 러너가 접속할 주소
API_BASE_URL=http://api:4000
ADMIN_WEB_URL=http://admin.fms.test:3000
USER_WEB_URL=http://user.fms.test:3001
CI=true
